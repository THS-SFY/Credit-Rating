<div class="row justify-content-center text-center animate__animated animate__fadeIn">
    <div class="col-md-8 col-lg-6 mt-5 pt-5">
        <div class="display-1 text-primary mb-4" style="font-weight: 900;">
            <%= error && error.status ? error.status : '500' %>
        </div>
        
        <h2 class="fw-bold mb-3"><%= title || 'Произошла ошибка' %></h2>
        
        <p class="text-muted lead mb-5">
            <%= message || 'К сожалению, мы не можем обработать ваш запрос в данный момент.' %>
        </p>

        <a href="/" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
            <i class="bi bi-house-door me-2"></i> Вернуться на главную
        </a>

        <% if (error && error.stack && process.env.NODE_ENV === 'development') { %>
            <div class="mt-5 text-start">
                <a class="text-muted small text-decoration-none" data-bs-toggle="collapse" href="#stackTrace" role="button" aria-expanded="false" aria-controls="stackTrace">
                    <i class="bi bi-bug me-1"></i> Показать технические детали (только для разработчиков)
                </a>
                <div class="collapse mt-3" id="stackTrace">
                    <div class="card card-body bg-light border-0">
                        <pre class="mb-0" style="font-size: 0.8rem; overflow-x: auto;"><code><%= error.stack %></code></pre>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>
