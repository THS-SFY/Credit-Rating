<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 fade-in-up delay-1">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i> База клиентов</h2>
        <p class="text-muted mb-0">Управление пользователями системы</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/users/create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Добавить
        </a>
    </div>
</div>

<div class="card border-0 fade-in-up delay-2">
    <div class="card-body p-0">
        <% if (users.length === 0) { %>
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                </div>
                <h5 class="fw-bold">Список пуст</h5>
                <p class="text-muted">Вы еще не добавили ни одного клиента в базу.</p>
                <a href="/users/create" class="btn btn-outline-primary mt-2">Добавить первого клиента</a>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4 rounded-top-start border-bottom-0">ID</th>
                            <th class="py-3 border-bottom-0">Пользователь</th>
                            <th class="py-3 border-bottom-0">ИНН</th>
                            <th class="py-3 border-bottom-0">Email</th>
                            <th class="py-3 border-bottom-0 text-end rounded-top-end px-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr data-user-id="<%= user.id %>" style="transition: all 0.2s;">
                                <td class="px-4 fw-medium text-muted">#<%= user.id %></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                            <%= user.firstName ? user.firstName.charAt(0).toUpperCase() : user.username.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= user.firstName %> <%= user.lastName %></div>
                                            <div class="text-muted small">@<%= user.username %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-medium text-secondary"><%= user.inn || '—' %></td>
                                <td>
                                    <span class="text-muted"><i class="bi bi-envelope me-1"></i><%= user.email %></span>
                                </td>
                                <td class="text-end px-4">
                                    <div class="btn-group border rounded-pill shadow-sm" role="group">
                                        <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-light text-primary border-0 rounded-start-pill px-3" title="Редактировать">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <div class="vr border-light"></div>
                                        <button type="button" class="btn btn-sm btn-light text-danger border-0 rounded-end-pill px-3" 
                                                onclick="deleteUser(<%= user.id %>, '<%= user.username %>')" title="Удалить">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Пагинация -->
            <% if (pagination && pagination.total > 1) { %>
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-center rounded-bottom">
                    <nav aria-label="Навигация">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item <%= !pagination.hasPrevious ? 'disabled' : '' %>">
                                <a class="page-link border-0 rounded-start-pill px-3" href="?page=<%= pagination.current - 1 %>">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            
                            <% for (let i = 0; i < pagination.total; i++) { %>
                                <li class="page-item <%= i === pagination.current ? 'active' : '' %>">
                                    <a class="page-link border-0 mx-1 rounded-circle <%= i === pagination.current ? 'shadow-sm' : '' %>" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;" href="?page=<%= i %>"><%= i + 1 %></a>
                                </li>
                            <% } %>
                            
                            <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                                <a class="page-link border-0 rounded-end-pill px-3" href="?page=<%= pagination.current + 1 %>">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            <% } %>
        <% } %>
    </div>
</div>

<script>
function deleteUser(userId, username) {
    if (confirm(`Удалить клиента @${username} из базы данных? Действие необратимо.`)) {
        const row = document.querySelector(`tr[data-user-id="${userId}"]`);
        row.style.opacity = '0.5';
        
        fetch(`/users/${userId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            if (response.ok) {
                row.classList.add('animate__animated', 'animate__zoomOutLeft');
                setTimeout(() => location.reload(), 400);
            } else {
                row.style.opacity = '1';
                alert('Ошибка сервера при удалении');
            }
        })
        .catch(error => {
            row.style.opacity = '1';
            console.error('Error:', error);
            alert('Сбой сети при удалении');
        });
    }
}
</script>
